<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Change product_id to product_template_id in stock move views
    Hide product_id and show product_template_id instead-->
    <record id="view_picking_move_tree" model="ir.ui.view">
        <field name="name">stock.move.list.inherit.product.configurator</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_picking_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='product_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//list/field[@name='product_id']" position="after">
                <field name="product_template_id"
                    string="Product"
                    required="1"
                    readonly="(state != 'draft' and not additional) or move_lines_count &gt; 0"
                    optional="show"
                    context="{'default_is_storable': True}"
                    domain="[('type', '!=', 'service')]"
                    widget="sm_product_many2one"
                    options="{'show_label_warning': True}"/>
                <!-- Keep product_id as invisible field so it's loaded in record data for variant display -->
                <field name="product_id" invisible="1" column_invisible="1"/>
                <!-- <field name="product_config_mode" invisible="1"/>
                <field name="product_custom_attribute_value_ids" invisible="1" />
                <field name="product_template_attribute_value_ids" invisible="1" />
                <field name="product_no_variant_attribute_value_ids" invisible="1" />
                <field name="is_configurable_product" invisible="1"/> -->
            </xpath>
        </field>
    </record>

    <record id="view_move_tree" model="ir.ui.view">
        <field name="name">stock.move.list.inherit.product.configurator.tree</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='product_id']" position="replace">
                <field name="product_template_id" string="Product" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Update form view for stock.move operations -->
    <record id="view_stock_move_operations" model="ir.ui.view">
        <field name="name">stock.move.operations.form.inherit.product.configurator</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//form//field[@name='product_id']" position="replace">
                <field name="product_template_id" 
                       readonly="id or move_line_ids"
                       widget="sm_product_many2one"
                       options="{'show_label_warning': True}"/>
                <!-- Keep product_id as invisible field so it's loaded in record data for variant display -->
                <field name="product_id" invisible="1" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Update picking form view - change product_id to product_template_id in move_ids list -->
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.product.configurator</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Update product_id field in move_ids list within picking form -->
            <xpath expr="//field[@name='move_ids']//list//field[@name='product_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']//list//field[@name='product_id']" position="after">
                <field name="product_template_id"
                    string="Product"
                    context="{'default_is_storable': True}"
                    required="1"
                    readonly="(state != 'draft' and not additional) or move_lines_count &gt; 0"
                    force_save="1"
                    widget="sm_product_many2one"
                    options="{'show_label_warning': True}"/>
                <!-- Keep product_id as invisible field so it's loaded in record data for variant display -->
                <field name="product_id" invisible="1" column_invisible="1"/>
<!--                <field name="product_config_mode" invisible="1"/>-->
<!--                <field name="product_custom_attribute_value_ids" invisible="1" />-->
<!--                <field name="product_template_attribute_value_ids" invisible="1" />-->
<!--                <field name="product_no_variant_attribute_value_ids" invisible="1" />-->
<!--                <field name="is_configurable_product" invisible="1"/>-->
            </xpath>
        </field>
    </record>
</odoo>

